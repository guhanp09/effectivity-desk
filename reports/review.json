    "incorporated_material": "Boeing Requirements Bulletins are referenced but their complete effectivity tables, procedures and timing are not available here.",
    "review_notes": [
      {
        "paragraph": "(c), (g), (h)",
        "interpretation": "787-8/-9/-10 model scope remains conditional on the referenced 2022 Requirements Bulletin. The retained reference-date exception uses June 29, 2023; do not substitute the new AD date throughout."
      },
      {
        "paragraph": "(j), (k)",
        "interpretation": "New actions depend on the 2025 Issue 002 Requirements Bulletin. The specified Issue 001 date reference is replaced by June 3, 2026; other timing details require the incorporated document."
      },
      {
        "paragraph": "(l)",
        "interpretation": "Completion of the new actions terminates retained paragraph (g) only for the airplanes identified in the new Requirements Bulletin. A new revision is not blanket closeout evidence."
      },
      {
        "paragraph": "(m)",
        "interpretation": "The old-part installation prohibition is conditional on prior replacement at the same inspection location. A 787-10 cannot be dismissed just because the new-inspection discussion concerns 787-8/-9."
      },
      {
        "paragraph": "(i), discussion of previous-action credit",
        "interpretation": "Retained credit has explicit scope and dates. The public discussion rejects automatic credit for the earlier Issue 001 new-action bulletin; no generic old-revision credit is assumed."
      },
      {
        "paragraph": "(n)",
        "interpretation": "AMOC approval belongs to the specified FAA authority or authorized ODA under the AD provisions. This software has no approval or maintenance-release function."
      }
    ],
